# Neon Postgres (get connection string from neon.tech > Dashboard > Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin secret for viewing RSVPs via /admin page (set this to any strong password)
ADMIN_SECRET=your-admin-secret-here

# Resend email (get API key from resend.com, free tier: 100 emails/day)
RESEND_API_KEY=re_your-api-key-here

# Email settings
EMAIL_FROM=Sethu at 60 <onboarding@resend.dev>
HOST_EMAIL=your-email@example.com
